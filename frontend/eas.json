{
  "cli": { "version": ">= 13.0.0" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://level-up-backend-elhs.onrender.com",
        "EXPO_PUBLIC_API_MODE": "live"
      }
    },
    "production": {
      "android": { "buildType": "app-bundle" },
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://level-up-backend-elhs.onrender.com",
        "EXPO_PUBLIC_API_MODE": "live"
      }
    }
  }
}
