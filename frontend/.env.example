# API mode: "mock" (default in dev, no backend needed) or "live"
# Production builds MUST use "live".
EXPO_PUBLIC_API_MODE=live

# Backend base URL (used when API_MODE=live).
# Must be https, no trailing slash.
# EAS builds need these set in the build profile or EAS env vars because .env is gitignored.
EXPO_PUBLIC_API_URL=https://YOUR-BACKEND.onrender.com